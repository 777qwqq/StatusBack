<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key><string>状态栏返回</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>基本设置</string>
            <key>footerText</key><string>点击悬浮球即可返回上一级；已到根页面时按下方设置回主屏幕。悬浮球可拖动，位置会被记住。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用插件</string>
            <key>key</key><string>enabled</string>
            <key>defaults</key><string>com.catpaw.statusback</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>显示悬浮球</string>
            <key>key</key><string>showFloatButton</string>
            <key>defaults</key><string>com.catpaw.statusback</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>label</key><string>不透明度</string>
            <key>key</key><string>floatButtonAlpha</string>
            <key>defaults</key><string>com.catpaw.statusback</string>
            <key>default</key><real>0.85</real>
            <key>min</key><real>0.2</real>
            <key>max</key><real>1.0</real>
            <key>showValue</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>label</key><string>大小</string>
            <key>key</key><string>floatButtonSize</string>
            <key>defaults</key><string>com.catpaw.statusback</string>
            <key>default</key><real>48</real>
            <key>min</key><real>32</real>
            <key>max</key><real>96</real>
            <key>showValue</key><true/>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>返回行为</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSegmentCell</string>
            <key>label</key><string>到根之后</string>
            <key>key</key><string>fallbackBehavior</string>
            <key>defaults</key><string>com.catpaw.statusback</string>
            <key>default</key><integer>1</integer>
            <key>validValues</key>
            <array>
                <integer>0</integer>
                <integer>1</integer>
            </array>
            <key>validTitles</key>
            <array>
                <string>停在当前页</string>
                <string>回主屏幕</string>
            </array>
            <key>footerText</key><string>回主屏幕：连续点击到根后自动回到桌面。</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>关于</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>查看源码</string>
            <key>action</key><string>sbk_statusback_openRepository:</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>Telegram 频道</string>
            <key>action</key><string>sbk_statusback_openTelegram:</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>QQ 交流群</string>
            <key>action</key><string>sbk_statusback_openQQ:</string>
        </dict>
    </array>
</dict>
</plist>
